@using FakeStoreWeb.Services
@inject SesionUsuario Sesion
@inject NavigationManager Navigation

<div class="sidebar-brand">
    <a class="brand-link" href="">
        <span class="bi bi-bag-heart-fill brand-icon"></span>
        <span>Fake<span class="brand-accent">Store</span></span>
    </a>
</div>

<div class="sidebar-menu">
    <nav class="nav flex-column">

        <div class="nav-section-title">MENÚ PRINCIPAL</div>

        <div class="nav-item">
            <NavLink class="nav-link menu-link" href="login"
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span>
                <span>Inicio</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link menu-link" href="products">
                <span class="bi bi-grid-fill" aria-hidden="true"></span>
                <span>Productos</span>
            </NavLink>
        </div>

        <div class="nav-section-title">MI CUENTA</div>

        <div class="nav-item">
            <NavLink class="nav-link menu-link" href="login">
                <span class="bi bi-person-circle" aria-hidden="true"></span>
                <span>Iniciar sesión</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <button type="button"
                    class="nav-link menu-link logout-link"
                    @onclick="CerrarSesion">
                <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                <span>Cerrar sesión</span>
            </button>
        </div>

    </nav>
</div>

<div class="sidebar-footer">
    <span class="bi bi-heart-fill" aria-hidden="true"></span>
    <div>
        <strong>Tu tienda favorita</strong>
        <small>Descubre algo especial</small>
    </div>
</div>

@code {
    private void CerrarSesion()
    {
        Sesion.CerrarSesion();
        Navigation.NavigateTo("/login", replace: true);
    }
}
