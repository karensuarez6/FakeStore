
@page "/login"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using FakeStoreWeb.Services
@inject SesionUsuario Sesion
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión | FakeStore</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            Fake<span>Store</span>
        </div>

        <p class="login-label">TIENDA ONLINE</p>
        <h1>¡Qué bueno tenerte aquí!</h1>
        <p class="login-description">
            Inicia sesión para descubrir nuestros productos.
        </p>

        <EditForm Model="@formulario" OnSubmit="@IniciarSesion">
            <div class="login-field">
                <label for="usuario">Nombre de usuario</label>
                <InputText id="usuario"
                           class="login-input"
                           @bind-Value="formulario.NombreUsuario"
                           placeholder="Ingresa tu usuario" />
            </div>

            <div class="login-field">
                <label for="contrasena">Contraseña</label>
                <InputText id="contrasena"
                           type="password"
                           class="login-input"
                           @bind-Value="formulario.Contrasena"
                           placeholder="Ingresa tu contraseña" />
            </div>

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <p class="login-error">@mensaje</p>
            }

            <button type="submit"
                    class="login-button"
                    disabled="@cargando">
                @(cargando ? "Validando..." : "Iniciar sesión")
            </button>
        </EditForm>
        <p class="login-description">
        ¿No tienes una cuenta?
        <a href="/registro">Regístrate aquí</a>
</p>
    </div>
</div>

@code {
    private LoginFormulario formulario = new();
    private string mensaje = string.Empty;
    private bool cargando;

    private async Task IniciarSesion()
    {
        mensaje = string.Empty;

        if (string.IsNullOrWhiteSpace(formulario.NombreUsuario) ||
            string.IsNullOrWhiteSpace(formulario.Contrasena))
        {
            mensaje = "Ingresa tu usuario y contraseña.";
            return;
        }

        cargando = true;

        try
        {
            var cliente = HttpClientFactory.CreateClient("FakeStore");

            var respuesta = await cliente.PostAsJsonAsync(
                "api/Auth/login",
                new
                {
                    nombreUsuario = formulario.NombreUsuario,
                    contrasena = formulario.Contrasena
                });

            if (!respuesta.IsSuccessStatusCode)
            {
                mensaje = "Usuario o contraseña incorrectos.";
                return;
            }

            var resultado = await respuesta.Content
                .ReadFromJsonAsync<RespuestaLogin>();

            if (resultado is null ||
                string.IsNullOrWhiteSpace(resultado.Token))
            {
                mensaje = "La API no devolvió un token válido.";
                return;
            }

            Sesion.IniciarSesion(resultado.Token);
            Navigation.NavigateTo("/products", replace: true);

        }
        catch (HttpRequestException)
        {
            mensaje = "No se pudo conectar con la API. Verifica que esté ejecutándose.";
        }
        catch (Exception)
        {
            mensaje = "Ocurrió un error al iniciar sesión.";
        }
        finally
        {
            cargando = false;
        }
    }

    private class LoginFormulario
    {
        public string NombreUsuario { get; set; } = string.Empty;
        public string Contrasena { get; set; } = string.Empty;
    }

    private class RespuestaLogin
    {
        public string Token { get; set; } = string.Empty;
    }
}
